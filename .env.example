# ==============================================================================
# Calendar Integration - Environment Variables (.env.example)
# All values shown below are non-secret placeholders.
#
# Every booking is written to BOTH Google Calendar and Outlook. The deployment is
# fail-closed: when CALENDAR_PROVIDER is anything other than "none", both
# provider credential blocks and all three dentist calendar IDs must be
# configured, or calendar resolution throws. Use "none" for local-only mode.
# ==============================================================================

# "both" (default) or "none" (local-only, no external calendars).
CALENDAR_PROVIDER=both

# Google Calendar (OAuth 2.0 Delegated Access)
# Use either this delegated block OR the service-account block below. When both
# are configured, the service account wins. Prefer entering these in the Admin
# Console (/admin) so they are stored encrypted instead of living in the env.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token
GOOGLE_CALENDAR_JUNIOR=junior-dentist-calendar-id@group.calendar.google.com
GOOGLE_CALENDAR_SENIOR_1=senior-1-calendar-id@group.calendar.google.com
GOOGLE_CALENDAR_SENIOR_2=senior-2-calendar-id@group.calendar.google.com

# Google Calendar (Service Account, JWT bearer grant)
# Values come from the downloaded key JSON: "client_email" and "private_key".
# The private key may keep its escaped \n sequences; they are restored on load.
# Each dentist calendar must be shared with the service account email, otherwise
# it sees no calendars at all.
GOOGLE_SERVICE_ACCOUNT_EMAIL=name@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Microsoft Outlook / Microsoft Graph (Entra ID Delegated Access)
MICROSOFT_TENANT_ID=your-microsoft-tenant-id-or-common
MICROSOFT_CLIENT_ID=your-microsoft-app-registration-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REFRESH_TOKEN=your-microsoft-oauth-refresh-token
MICROSOFT_CALENDAR_JUNIOR=your-microsoft-calendar-id-junior
MICROSOFT_CALENDAR_SENIOR_1=your-microsoft-calendar-id-senior-1
MICROSOFT_CALENDAR_SENIOR_2=your-microsoft-calendar-id-senior-2

# OpenAI / AI Chat Provider
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Gemini Live API / Conversational Voice AI
# The server mints a single-use ephemeral token; the master key never reaches the browser.
# The model MUST support bidiGenerateContent, e.g. gemini-2.5-flash-native-audio-latest,
# gemini-3.1-flash-live-preview, or gemini-3.8-live. Text-only models such as
# gemini-2.0-flash are rejected by the socket with code 1008.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_LIVE_VOICE=Aoede

# Kokoro text-to-speech service (OpenAI-compatible API)
KOKORO_TTS_BASE_URL=http://localhost:8880/v1
KOKORO_TTS_VOICE=af_heart

# PostgreSQL Database (Drizzle ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dental_clinic
CLINIC_TIMEZONE=Asia/Jakarta

# ==============================================================================
# Admin Console (production security)
# Generate the password hash with: bun run hash:admin-password "your password"
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit real values. The encryption key must stay outside the database.
# ==============================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt:<salt-base64>:<hash-base64>
SETTINGS_ENCRYPTION_KEY=replace-with-64-hex-chars
# Optional: previous encryption key, decrypt-only, for key rotation.
SETTINGS_ENCRYPTION_KEY_PREVIOUS=
APP_BASE_URL=http://localhost:3000

# ==============================================================================
# Calendar synchronization retries
# Failed provider writes are retried with backoff by an external scheduler that
# calls POST /api/v1/admin/reconcile-calendar with this bearer token. Generate it
# with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))".
# When unset, the endpoint returns 503 and retries only run opportunistically.
# ==============================================================================
CALENDAR_RECONCILE_TOKEN=replace-with-32-random-bytes-hex
